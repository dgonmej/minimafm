---
import Layout from '../../layouts/Layout.astro';
import ProgramFeature from '../../components/ProgramFeature.astro';
import { getProgramas } from '../../lib/api';

const programas = await getProgramas();

const categorias = ['Todos', ...new Set(programas.map((p) => p.categoria))];
---

<Layout title="Programas" description="Todos los programas de Mínima FM: actualidad, música, tradición, deporte y comunidad.">
  <div class="container">
    <header class="page-head">
      <h1 class="page-title">Programas</h1>
      <p class="page-intro">
        {programas.length} programas hechos por y para la gente del Valle: información, tradición, deporte y mucha música.
      </p>
    </header>

    <dgonmej-ui-segmented-control
      id="filter"
      class="filter"
      label="Filtrar por tipo de programa"
      value="Todos"
      data-options={JSON.stringify(categorias.map((c) => ({ value: c, label: c })))}
    ></dgonmej-ui-segmented-control>

    <ul class="programs">
      {
        programas.map((p) => (
          <li data-category={p.categoria}>
            <ProgramFeature programa={p} />
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<script>
  import { enAntena, parrilla } from '../../lib/schedule';

  const setup = () => {
    const filter = document.getElementById('filter') as (HTMLElement & { options: unknown }) | null;
    if (!filter) return;

    // Filtro por tipo de programa
    customElements.whenDefined('dgonmej-ui-segmented-control').then(() => {
      filter.options = JSON.parse(filter.dataset.options ?? '[]');
    });
    filter.addEventListener('ui-change', (e) => {
      const value = (e as CustomEvent<{ value: string }>).detail.value;
      document.querySelectorAll<HTMLElement>('.programs > li').forEach((li) => {
        li.hidden = value !== 'Todos' && li.dataset.category !== value;
      });
    });

    // Marca "En antena" el programa que suena ahora
    const { actual } = enAntena(parrilla());
    document.querySelectorAll<HTMLElement>('[data-program]').forEach((card) => {
      const badge = card.querySelector<HTMLElement>('.on-air');
      if (badge) badge.hidden = card.dataset.program !== actual?.programa.id;
    });
  };
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .filter {
    display: block;
    max-width: 100%;
    margin-bottom: var(--ui-space-6);
    overflow-x: auto;
  }

  /* Pocas fichas y anchas: una columna en movil y tablet, dos en escritorio */
  .programs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ui-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1100px) {
    .programs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .programs > li[hidden] {
    display: none;
  }

  /* Al llegar desde la parrilla (#programa), la ficha se resalta */
  .programs :global(dgonmej-ui-card:target)::part(card) {
    box-shadow:
      inset 0 0 0 2px var(--ui-color-primary),
      var(--ui-shadow-lg);
  }
</style>
