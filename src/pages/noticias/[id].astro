---
import { getNoticia } from '../../lib/api';
import { renderMarkdown } from '../../lib/markdown';
import Layout from '../../layouts/Layout.astro';
import { formatoFechaLarga, iso } from '../../lib/format';

const noticia = await getNoticia(Astro.params.id!);
if (!noticia) return Astro.rewrite('/404/');
const { html } = renderMarkdown(noticia.cuerpo);
const { titulo, fecha, categoria, autor, resumen } = noticia.data;
const base = import.meta.env.BASE_URL;
---

<Layout title={titulo} description={resumen}>
  <article class="container article">
    <dgonmej-ui-button variant="ghost" size="small" href={`${base}noticias/`}>
      <dgonmej-ui-icon name="chevron-left" size="16"></dgonmej-ui-icon>Noticias
    </dgonmej-ui-button>

    <header>
      <dgonmej-ui-badge variant="accent">{categoria}</dgonmej-ui-badge>
      <h1>{titulo}</h1>
      <p class="lead">{resumen}</p>
      <p class="byline">
        <dgonmej-ui-avatar size="sm" name={autor}></dgonmej-ui-avatar>
        <span>
          <strong>{autor}</strong>
          <time datetime={iso(fecha)}>{formatoFechaLarga(fecha)}</time>
        </span>
      </p>
    </header>

    <div class="prose">
      <Fragment set:html={html} />
    </div>
  </article>
</Layout>

<style>
  .article {
    max-width: 720px;
    padding-block: var(--ui-space-6) var(--ui-space-8);
  }

  header {
    margin-top: var(--ui-space-5);
    padding-bottom: var(--ui-space-6);
    margin-bottom: var(--ui-space-6);
    border-bottom: 1px solid var(--ui-color-separator);
  }

  h1 {
    margin: var(--ui-space-3) 0 0;
    font-family: var(--ui-font-family-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .lead {
    margin: var(--ui-space-4) 0 0;
    color: var(--ui-color-text-muted);
    font-size: var(--ui-font-size-title3);
    line-height: 1.45;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: var(--ui-space-3);
    margin: var(--ui-space-5) 0 0;
  }

  .byline span {
    display: grid;
    font-size: var(--ui-font-size-subhead);
  }

  .byline time {
    color: var(--ui-color-text-muted);
  }

  .prose {
    font-size: var(--ui-font-size-body);
    line-height: 1.65;
  }

  .prose :global(p) {
    margin: 0 0 var(--ui-space-4);
  }
</style>
