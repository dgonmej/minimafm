---
import { getPaginas } from '../../lib/api';
import { renderMarkdown } from '../../lib/markdown';
import Layout from '../../layouts/Layout.astro';
import { formatoFecha, iso } from '../../lib/format';

const docs = (await getPaginas()).sort((a, b) => a.data.orden - b.data.orden);
const doc = docs.find((d) => d.id === Astro.params.id);
if (!doc) return Astro.rewrite('/404/');
const { html, headings } = renderMarkdown(doc.cuerpo);
const base = import.meta.env.BASE_URL;
const indice = headings.filter((h) => h.depth === 2);
---

<Layout title={doc.data.titulo} description={doc.data.resumen}>
  <div class="container legal">
    <!-- Lateral: los tres documentos y el indice del actual -->
    <aside class="side">
      <nav aria-label="Información legal">
        <p class="side-title">Información legal</p>
        <ul class="docs">
          {
            docs.map((d) => (
              <li>
                <a href={`${base}legal/${d.id}/`} aria-current={d.id === doc.id ? 'page' : undefined}>
                  {d.data.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {
        indice.length > 0 && (
          <nav class="toc" aria-label="En esta página">
            <p class="side-title">En esta página</p>
            <ol>
              {indice.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>

    <article class="doc">
      <header>
        <h1>{doc.data.titulo}</h1>
        <p class="summary">{doc.data.resumen}</p>
        <p class="updated">
          Última actualización: <time datetime={iso(doc.data.actualizado)}>{formatoFecha(doc.data.actualizado)}</time>
        </p>
      </header>
      <div class="prose">
        <Fragment set:html={html} />
      </div>
    </article>
  </div>
</Layout>

<style>
  .legal {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ui-space-6);
    padding-block: var(--ui-space-8);
  }

  @media (min-width: 900px) {
    .legal {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: calc(var(--ui-space-8) * 1.5);
      align-items: start;
    }
    .side {
      position: sticky;
      top: 80px;
    }
  }

  .side {
    display: grid;
    gap: var(--ui-space-6);
  }

  .side-title {
    margin: 0 0 var(--ui-space-2);
    color: var(--ui-color-text-muted);
    font-size: var(--ui-font-size-footnote);
    font-weight: 600;
  }

  .docs,
  .toc ol {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* En movil los documentos van en fila, como pestañas */
  @media (max-width: 899px) {
    .docs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--ui-space-2);
    }
    .toc {
      display: none;
    }
  }

  .docs a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: var(--ui-space-2) var(--ui-space-3);
    border-radius: var(--ui-radius-control);
    color: var(--ui-color-text);
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 899px) {
    .docs a {
      min-height: 44px;
      background: var(--ui-color-fill);
    }
  }

  .docs a[aria-current='page'] {
    color: var(--ui-color-primary-text);
    background: var(--ui-color-primary-tint);
  }

  @media (hover: hover) {
    .docs a:not([aria-current]):hover {
      background: var(--ui-color-fill-strong);
    }
  }

  .toc ol {
    padding-left: var(--ui-space-3);
    border-left: 1px solid var(--ui-color-separator);
  }

  .toc a {
    display: block;
    padding: 4px 0;
    color: var(--ui-color-text-muted);
    font-size: var(--ui-font-size-subhead);
    text-decoration: none;
  }

  @media (hover: hover) {
    .toc a:hover {
      color: var(--ui-color-text);
    }
  }

  /* ---------- Documento ---------- */
  .doc {
    max-width: 720px;
  }

  h1 {
    margin: 0;
    font-family: var(--ui-font-family-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .summary {
    margin: var(--ui-space-3) 0 0;
    color: var(--ui-color-text-muted);
    font-size: var(--ui-font-size-title3);
    line-height: 1.45;
  }

  .updated {
    display: inline-block;
    margin: var(--ui-space-5) 0 0;
    padding: 4px 12px;
    border-radius: var(--ui-radius-control);
    background: var(--ui-color-fill);
    font-size: var(--ui-font-size-footnote);
    font-weight: 600;
  }

  .prose {
    margin-top: var(--ui-space-6);
    line-height: 1.65;
  }

  .prose :global(h2) {
    margin: var(--ui-space-8) 0 var(--ui-space-3);
    padding-top: var(--ui-space-6);
    border-top: 1px solid var(--ui-color-separator);
    font-size: var(--ui-font-size-title3);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 var(--ui-space-4);
  }

  .prose :global(ul) {
    padding-left: 1.25em;
  }

  .prose :global(li + li) {
    margin-top: var(--ui-space-1);
  }

  .prose :global(code) {
    padding: 1px 6px;
    border-radius: var(--ui-radius-sm);
    background: var(--ui-color-fill);
    font-size: 0.9em;
  }

  /* Tabla de cookies: se desplaza sola si no cabe en movil */
  .prose :global(table) {
    display: block;
    width: 100%;
    margin: 0 0 var(--ui-space-5);
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--ui-font-size-subhead);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--ui-space-3);
    border-bottom: 1px solid var(--ui-color-separator);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(td code) {
    white-space: nowrap;
  }

  .prose :global(th) {
    color: var(--ui-color-text-muted);
    font-weight: 600;
  }
</style>
