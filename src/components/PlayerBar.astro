---
import { getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import { getRadio } from '../lib/api';

const radio = await getRadio();

// Portada del reproductor (tambien la usan los controles del sistema en el movil)
const artwork = await getImage({ src: logo, width: 500, format: 'png' });
---

<!--
  Reproductor fijo abajo. transition:persist lo mantiene vivo al navegar entre paginas,
  asi que la radio no se corta. El subtitulo muestra el programa que suena ahora.
-->
<div class="player-bar" transition:persist="player">
  <dgonmej-ui-audio-player
    id="player"
    variant="compact"
    live
    heading={`${radio.nombre} ${radio.frecuencia}`}
    subheading={radio.zona}
    src={radio.stream}
    artwork={artwork.src}
  ></dgonmej-ui-audio-player>
</div>

<script>
  import { enAntena, parrilla } from '../lib/schedule';

  // Actualiza "Ahora: ..." en el reproductor cada minuto
  const player = document.getElementById('player') as HTMLElement & { subheading: string };
  const update = () => {
    const { actual, continuidad } = enAntena(parrilla());
    player.subheading = `Ahora: ${actual ? actual.programa.nombre : continuidad.nombre}`;
  };
  update();
  setInterval(update, 60_000);
</script>

<style>
  .player-bar {
    position: fixed;
    z-index: 40;
    left: 50%;
    bottom: calc(var(--ui-space-3) + env(safe-area-inset-bottom));
    width: min(calc(100% - 2 * var(--ui-space-3) - env(safe-area-inset-left) - env(safe-area-inset-right)), 560px);
    transform: translateX(-50%);
  }

  /* Material de vidrio sobre el reproductor compacto */
  .player-bar dgonmej-ui-audio-player::part(player) {
    border: 1px solid var(--ui-material-border);
    background: var(--ui-material-bg);
    box-shadow: var(--ui-shadow-lg);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .player-bar dgonmej-ui-audio-player::part(player) {
      background: var(--ui-material-bg-translucent);
      -webkit-backdrop-filter: var(--ui-material-blur);
      backdrop-filter: var(--ui-material-blur);
    }
  }

</style>
