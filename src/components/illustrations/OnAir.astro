---
/*
 * Ilustracion de la pagina 401: la puerta del estudio cerrada, el piloto "On air"
 * encendido y un cordon que corta el paso. Usa los tokens del sitio (tema claro y oscuro).
 */
---

<svg class="on-air-art" viewBox="0 0 520 340" role="img" aria-labelledby="onair-title">
  <title id="onair-title">La puerta del estudio cerrada, con el cartel On air encendido y un cordón que impide el paso</title>
  <defs>
    <linearGradient id="o-door" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4a3a9e" />
      <stop offset="1" stop-color="#2a1f63" />
    </linearGradient>
    <linearGradient id="o-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6b5bd0" stop-opacity="0.55" />
      <stop offset="1" stop-color="#1a1340" stop-opacity="0.9" />
    </linearGradient>
    <radialGradient id="o-glow">
      <stop offset="0" stop-color="#ff3b30" stop-opacity="0.55" />
      <stop offset="1" stop-color="#ff3b30" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="o-post" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#d8b25a" />
      <stop offset="0.5" stop-color="#f5d98a" />
      <stop offset="1" stop-color="#b18a2e" />
    </linearGradient>
  </defs>

  <!-- Pared y suelo -->
  <rect class="o-wall" x="20" y="20" width="480" height="290" rx="18" />
  <line class="o-floor" x1="20" y1="310" x2="500" y2="310" />
  <ellipse class="o-shadow" cx="260" cy="314" rx="200" ry="8" />

  <!-- Resplandor del cartel -->
  <ellipse class="o-glow" cx="260" cy="58" rx="130" ry="56" fill="url(#o-glow)" />

  <!-- Cartel ON AIR -->
  <g class="o-sign">
    <rect x="190" y="36" width="140" height="44" rx="10" class="o-sign-box" />
    <rect x="196" y="42" width="128" height="32" rx="7" class="o-sign-face" />
    <text x="260" y="66" text-anchor="middle" class="o-sign-text">ON AIR</text>
  </g>

  <!-- Marco y puerta -->
  <rect class="o-frame" x="176" y="96" width="168" height="214" rx="8" />
  <rect x="188" y="106" width="144" height="204" rx="4" fill="url(#o-door)" />
  <!-- Paneles de la puerta acolchada de estudio -->
  <g class="o-quilt">
    <line x1="188" y1="200" x2="332" y2="200" />
    <line x1="188" y1="250" x2="332" y2="250" />
    <line x1="236" y1="200" x2="236" y2="310" />
    <line x1="284" y1="200" x2="284" y2="310" />
  </g>
  <!-- Ventanuco -->
  <rect x="226" y="124" width="68" height="56" rx="10" fill="url(#o-glass)" class="o-window" />
  <line class="o-reflex" x1="238" y1="170" x2="258" y2="134" />
  <!-- Pomo y cerradura -->
  <circle class="o-knob" cx="316" cy="214" r="7" />
  <rect class="o-lock" x="312" y="228" width="8" height="12" rx="2" />

  <!-- Postes del cordon -->
  <g class="o-posts">
    <rect x="104" y="196" width="10" height="110" rx="5" fill="url(#o-post)" />
    <ellipse cx="109" cy="306" rx="26" ry="7" fill="url(#o-post)" />
    <circle cx="109" cy="194" r="9" fill="url(#o-post)" />
    <rect x="406" y="196" width="10" height="110" rx="5" fill="url(#o-post)" />
    <ellipse cx="411" cy="306" rx="26" ry="7" fill="url(#o-post)" />
    <circle cx="411" cy="194" r="9" fill="url(#o-post)" />
  </g>

  <!-- Cordon rojo que cruza delante de la puerta -->
  <path class="o-rope" d="M114 202 C 200 268, 320 268, 406 202" />

  <!-- Cartel colgando del cordon -->
  <g class="o-tag">
    <line x1="246" y1="250" x2="252" y2="262" class="o-string" />
    <line x1="274" y1="250" x2="268" y2="262" class="o-string" />
    <rect x="226" y="260" width="68" height="30" rx="6" class="o-tag-box" />
    <!-- Simbolo de prohibido -->
    <circle cx="260" cy="275" r="9" class="o-no" />
    <line x1="253.6" y1="281.4" x2="266.4" y2="268.6" class="o-no-bar" />
  </g>
</svg>

<style>
  .on-air-art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .o-wall {
    fill: var(--ui-color-surface);
    stroke: var(--ui-color-border);
    stroke-width: 2;
  }

  .o-floor {
    stroke: var(--ui-color-separator);
    stroke-width: 2;
  }

  .o-shadow {
    fill: var(--ui-color-text);
    opacity: 0.08;
  }

  .o-sign-box {
    fill: #2a2420;
  }

  .o-sign-face {
    fill: #d70015;
  }

  .o-sign-text {
    fill: #fff;
    font: 800 20px var(--ui-font-family);
    letter-spacing: 0.08em;
  }

  .o-frame {
    fill: var(--ui-color-surface-pressed);
    stroke: var(--ui-color-separator);
    stroke-width: 2;
  }

  .o-quilt line {
    stroke: rgb(255 255 255 / 0.12);
    stroke-width: 2;
  }

  .o-window {
    stroke: rgb(255 255 255 / 0.25);
    stroke-width: 3;
  }

  .o-reflex {
    stroke: rgb(255 255 255 / 0.35);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .o-knob,
  .o-lock {
    fill: #f5d98a;
  }

  .o-rope {
    fill: none;
    stroke: #c0182b;
    stroke-width: 9;
    stroke-linecap: round;
  }

  .o-string {
    stroke: var(--ui-color-text-muted);
    stroke-width: 2;
  }

  .o-tag-box {
    fill: var(--ui-color-background);
    stroke: var(--ui-color-separator);
    stroke-width: 2;
  }

  .o-no {
    fill: none;
    stroke: #d70015;
    stroke-width: 3;
  }

  .o-no-bar {
    stroke: #d70015;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .o-tag {
    transform-origin: 260px 250px;
  }

  /* El piloto respira como un ON AIR de verdad; el cartel colgado se mece un poco */
  @media (prefers-reduced-motion: no-preference) {
    .o-glow {
      animation: o-breathe 2.4s ease-in-out infinite alternate;
    }
    .o-sign-face {
      animation: o-flicker 2.4s ease-in-out infinite alternate;
    }
    .o-tag {
      animation: o-sway 3.2s cubic-bezier(0.32, 0.72, 0, 1) infinite alternate;
    }
  }

  @keyframes o-breathe {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes o-flicker {
    from {
      opacity: 0.88;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes o-sway {
    from {
      transform: rotate(-3deg);
    }
    to {
      transform: rotate(3deg);
    }
  }
</style>
