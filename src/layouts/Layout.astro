---
import 'dgonmej-ui/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PlayerBar from '../components/PlayerBar.astro';
import { getProgramas, getRadio } from '../lib/api';

interface Props {
  title?: string;
  description?: string;
}

const radio = await getRadio();
const { title, description = radio.descripcion } = Astro.props;
// Programas para calcular en el navegador lo que suena ahora (ver parrilla() en lib/schedule.ts)
const parrilla = (await getProgramas()).map(({ id, nombre, presentador, franjas }) => ({ id, nombre, presentador, franjas }));
const fullTitle = title ? `${title} | ${radio.nombre} ${radio.frecuencia}` : `${radio.nombre} ${radio.frecuencia} | La voz del Valle`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteName = `${radio.nombre} ${radio.frecuencia}`;

// Imagen al compartir (1200 x 630, en public/og.png) y datos de la emisora para Google
const image = new URL('/og.png', Astro.site).href;
const imageAlt = `${siteName}, la radio del ${radio.zona}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RadioStation',
  name: radio.nombre,
  alternateName: siteName,
  url: new URL('/', Astro.site).href,
  logo: new URL('/android-chrome-512x512.png', Astro.site).href,
  image,
  description: radio.descripcion,
  slogan: radio.lema,
  areaServed: radio.zona,
  address: radio.direccion,
  sameAs: radio.redes.map((r) => r.url),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/android-chrome-192x192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#f7f5f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151210" media="(prefers-color-scheme: dark)" />

    <!--
      Tema guardado aplicado antes de pintar (sin destello) y otra vez tras cada cambio de
      pagina: la navegacion sin recarga sustituye los atributos de <html>.
    -->
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const theme = localStorage.getItem('dgonmej-ui-theme');
            if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme);
            else document.documentElement.removeAttribute('data-theme');
          } catch {}
        };
        apply();
        if (!window.__minimaTheme) {
          window.__minimaTheme = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>

    <!-- Navegacion sin recarga: el reproductor sigue sonando al cambiar de pagina -->
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <script type="application/json" id="parrilla-data" set:html={JSON.stringify(parrilla).replace(/</g, '\\u003c')} />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <PlayerBar />

    <script>
      import 'dgonmej-ui';
    </script>
  </body>
</html>
